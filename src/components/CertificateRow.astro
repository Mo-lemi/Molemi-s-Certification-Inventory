---
import Preview from './Preview.astro';
import { getCategory, recordNumber, thumbImage, withBase, type Certificate } from '../lib/certificates';

interface Props {
  cert: Certificate;
}

const { cert } = Astro.props;
const domain = getCategory(cert.category).label;
const number = recordNumber(cert.id);
const detailId = `detail-${cert.id}`;
const thumb = thumbImage(cert.file);
const searchText = [cert.title, cert.issuer, domain, number, cert.credentialId, cert.description, ...cert.skills]
  .filter(Boolean)
  .join(' ')
  .toLowerCase();
---

<!-- One <tbody> per certificate: the summary row, plus a detail row that opens in place. -->
<tbody
  id={cert.id}
  data-row
  data-search={searchText}
  data-date={cert.dateEarned}
  data-title={cert.title.toLowerCase()}
  class="scroll-mt-4"
>
  <tr class="border-b border-rule align-top">
    <td class="hidden py-3 pr-4 font-mono text-xs leading-6 text-muted md:table-cell">{number}</td>
    <td class="py-3 pr-4">
      <button type="button" data-toggle aria-expanded="false" aria-controls={detailId} class="group flex w-full gap-3 text-left">
        <span data-toggle-icon class="w-3 shrink-0 font-mono leading-6 text-muted" aria-hidden="true">+</span>
        {
          thumb && (
            <img
              src={thumb}
              alt=""
              loading="lazy"
              decoding="async"
              class="mt-0.5 aspect-[1.414] w-14 shrink-0 self-start border border-rule bg-white object-cover object-top sm:w-20"
            />
          )
        }
        <span>
          <span class="block leading-6 font-medium underline-offset-4 group-hover:underline">{cert.title}</span>
          <span class="block text-muted">
            {cert.issuer}<span class="font-mono text-xs whitespace-nowrap sm:hidden"> · {cert.dateEarned}</span>
          </span>
        </span>
      </button>
    </td>
    <td class="hidden py-3 pr-4 leading-6 text-muted md:table-cell">{domain}</td>
    <td class="hidden py-3 pr-4 font-mono text-xs leading-6 whitespace-nowrap sm:table-cell">
      {cert.dateEarned}
      <span data-expired-flag data-expiry={cert.expiryDate} hidden class="block text-muted">expired</span>
    </td>
    <td class="py-3 text-right font-mono text-xs leading-6 whitespace-nowrap">
      {
        cert.verifyUrl && (
          <a href={cert.verifyUrl} target="_blank" rel="noopener noreferrer" class="link block">
            verify ↗
          </a>
        )
      }
      {
        cert.file && (
          <a href={withBase(cert.file)} target="_blank" rel="noopener noreferrer" class="link block">
            file ↗
          </a>
        )
      }
    </td>
  </tr>

  <tr id={detailId} data-detail hidden class="border-b border-rule bg-white">
    <td colspan="5" class="p-4 sm:p-6">
      <div class="grid gap-6 md:grid-cols-[1fr_1fr]">
        <div class="flex flex-col gap-4">
          {cert.description && <p class="max-w-prose leading-relaxed">{cert.description}</p>}
          <dl class="grid grid-cols-[auto_1fr] gap-x-4 gap-y-1.5 font-mono text-xs">
            <dt class="text-muted">record</dt>
            <dd>{number}</dd>
            <dt class="text-muted">issued_by</dt>
            <dd>{cert.issuer}</dd>
            <dt class="text-muted">earned</dt>
            <dd>{cert.dateEarned}</dd>
            {
              cert.expiryDate && (
                <>
                  <dt class="text-muted">expires</dt>
                  <dd>{cert.expiryDate}</dd>
                </>
              )
            }
            {
              cert.credentialId && (
                <>
                  <dt class="text-muted">credential_id</dt>
                  <dd class="break-all">{cert.credentialId}</dd>
                </>
              )
            }
            {
              cert.skills.length > 0 && (
                <>
                  <dt class="text-muted">skills</dt>
                  <dd>{cert.skills.join(', ')}</dd>
                </>
              )
            }
          </dl>
        </div>
        {
          cert.file && (
            <a href={withBase(cert.file)} target="_blank" rel="noopener noreferrer" class="block self-start border border-rule">
              <Preview cert={cert} />
            </a>
          )
        }
      </div>
    </td>
  </tr>
</tbody>
