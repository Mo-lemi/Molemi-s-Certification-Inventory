---
import profile from '../data/profile.json';
import { withBase } from '../lib/certificates';

const links = [
  { label: 'linkedin', href: profile.links.linkedin },
  { label: 'github', href: profile.links.github },
  { label: 'email', href: profile.links.email && `mailto:${profile.links.email}` },
].filter((link) => link.href);
---

<header class="border-b border-rule">
  <div class="mx-auto flex max-w-5xl items-start gap-5 px-4 pt-12 pb-8 sm:px-6">
    {profile.photo && <img src={withBase(profile.photo)} alt="" class="size-16 shrink-0 border border-rule object-cover sm:size-20" />}
    <div>
      <h1 class="font-display text-3xl leading-tight font-medium sm:text-4xl">{profile.name}</h1>
      <p class="mt-1 text-muted">{profile.tagline}</p>
      <p class="mt-3 max-w-xl text-sm">{profile.bio}</p>
      {
        links.length > 0 && (
          <ul class="mt-4 flex flex-wrap gap-x-5 gap-y-1 font-mono text-sm" aria-label="Contact links">
            {links.map((link) => (
              <li>
                <a
                  href={link.href}
                  target={link.label === 'email' ? undefined : '_blank'}
                  rel="noopener noreferrer"
                  class="link"
                >
                  {link.label} ↗
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </div>
</header>
