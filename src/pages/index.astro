---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import CertificateRow from '../components/CertificateRow.astro';
import profile from '../data/profile.json';
import { certificates, providerOf, slugify, types, type Certificate } from '../lib/certificates';

const newestFirst = (a: Certificate, b: Certificate) => b.dateEarned.localeCompare(a.dateEarned);

/** One top-level row in a group, with any certificates it includes listed in a dropdown under it. */
interface Entry {
  cert: Certificate;
  /** true when this certificate's main row lives in another group, so this row is a second copy. */
  copy: boolean;
  children: Certificate[];
}

interface Tab {
  id: string;
  label: string;
  /** Shorter name for the tab itself, so the tab row fits on one line; label is used elsewhere. */
  tabLabel?: string;
  note: string;
  /** Number of distinct certificates in the tab. */
  count: number;
  entries: Entry[];
}

const plain = (certs: Certificate[]): Entry[] => certs.sort(newestFirst).map((cert) => ({ cert, copy: false, children: [] }));
const distinct = (entries: Entry[]) => new Set(entries.flatMap((e) => [e.cert.id, ...e.children.map((c) => c.id)])).size;
const listNames = (names: string[]) =>
  names.length > 1 ? `${names.slice(0, -1).join(', ')} and ${names.at(-1)}` : names[0];

// Types with their own tab (Professional, Hackathons) versus types split into one tab per provider (courses, skills tests).
const ownTabTypes = types.filter((type) => !type.groupByProvider);
const byProvider = certificates.filter((c) => types.find((t) => t.id === c.type)?.groupByProvider);

// Certificates that include others (e.g. the Google AI Professional Certificate and its courses).
const programs = certificates.filter((c) => c.includes.length > 0);
const includedIds = new Set(programs.flatMap((p) => p.includes));

const providerTabs: Tab[] = [...new Set(byProvider.map((c) => providerOf(c.issuer)))].map((provider) => {
  const certs = byProvider.filter((c) => providerOf(c.issuer) === provider);
  // Included certificates sit under their program's dropdown instead of at the top level.
  const programEntries = programs
    .map((program) => ({
      cert: program,
      copy: !certs.includes(program),
      children: certs.filter((c) => program.includes.includes(c.id)).sort(newestFirst),
    }))
    .filter((entry) => entry.children.length > 0);
  const topLevel = certs.filter((c) => !includedIds.has(c.id) && !programEntries.some((e) => e.cert === c));
  const entries = [...programEntries, ...plain(topLevel)];
  return {
    id: slugify(provider),
    label: provider,
    note: `Certificates earned through ${listNames([...new Set(certs.map((c) => c.issuer))])}.`,
    count: distinct(entries),
    entries,
  };
});
providerTabs.sort((a, b) => b.count - a.count || a.label.localeCompare(b.label));

// Every tab except "All" is one group; "All" stacks the groups in tab order.
const groups: Tab[] = [
  ...ownTabTypes
    .map((type) => {
      const entries = plain(certificates.filter((c) => c.type === type.id));
      return { id: type.id, label: type.label, tabLabel: type.tabLabel, note: type.note, count: entries.length, entries };
    })
    .filter((tab) => tab.count > 0),
  ...providerTabs,
];
const tabs: Tab[] = [
  {
    id: 'all',
    label: 'All',
    note: 'Every credential, course and competition on record. Open a group to see its certificates.',
    count: certificates.length,
    entries: [],
  },
  ...groups,
];
const firstProviderTab = providerTabs[0];

const updated = new Date().toISOString().slice(0, 10);
---

<Layout title={`${profile.name} | Certificates`} description={`${profile.name}: ${profile.tagline}. ${profile.bio}`}>
  <Header />

  <main class="mx-auto max-w-7xl px-4 py-8 sm:px-6">
    <div class="mb-10 flex flex-wrap items-center gap-3">
      <label class="min-w-0 flex-1 basis-60">
        <span class="sr-only">Search records</span>
        <input id="search" type="search" placeholder="search title, issuer, skill…" class="field w-full" />
      </label>
      <label class="flex items-center gap-2 font-mono text-xs text-muted">
        sort
        <select id="sort" class="field">
          <option value="newest">newest</option>
          <option value="oldest">oldest</option>
          <option value="title">a–z</option>
        </select>
      </label>
      <p id="result-count" class="ml-auto font-mono text-xs text-muted" aria-live="polite">
        {certificates.length} records
      </p>
    </div>

    <div role="tablist" aria-label="Filter certificates" class="tabs -mx-4 flex border-b border-ink px-4 sm:mx-0 sm:px-0">
      {
        tabs.map((tab, i) => (
          <button
            type="button"
            role="tab"
            id={`tab-${tab.id}`}
            data-tab={tab.id}
            data-note={tab.note}
            aria-selected={i === 0 ? 'true' : 'false'}
            aria-controls="records"
            tabindex={i === 0 ? 0 : -1}
            class:list={['tab', tab === firstProviderTab && 'tab-group-start']}
          >
            {tab.tabLabel ?? tab.label} <span data-tab-count class="font-mono text-xs text-muted">{tab.count}</span>
          </button>
        ))
      }
    </div>

    <section id="records" role="tabpanel" aria-labelledby="tab-all" class="mb-14">
      <p id="tab-note" class="mt-3 mb-2 text-sm text-muted">{tabs[0].note}</p>
      {
        groups.map((group) => (
          <section data-group={group.id} aria-labelledby={`heading-${group.id}`}>
            {/* In the All tab each group is a dropdown: this bar opens and closes its list. Other tabs hide the bar. */}
            <h2 data-group-heading id={`heading-${group.id}`} class="font-display text-lg font-medium sm:text-xl">
              <button
                type="button"
                data-group-toggle
                aria-expanded="false"
                aria-controls={`group-${group.id}`}
                class="group flex w-full items-baseline gap-3 border-b border-rule py-4 text-left hover:border-ink"
              >
                <span data-group-icon class="w-3 shrink-0 font-mono text-sm text-muted" aria-hidden="true">+</span>
                <span class="underline-offset-4 group-hover:underline">{group.label}</span>
                <span data-group-count class="ml-auto font-mono text-xs font-normal text-muted">
                  {group.count}
                </span>
              </button>
            </h2>
            <div id={`group-${group.id}`} data-group-body class="pb-6">
              <p data-group-note class="mt-3 mb-1 text-sm text-muted">{group.note}</p>
              <table class="w-full border-collapse text-left text-sm">
                <thead class="font-mono text-xs text-muted max-sm:sr-only">
                  <tr class="border-b border-rule">
                    <th scope="col" class="hidden w-24 py-2 pr-4 font-normal md:table-cell">no.</th>
                    <th scope="col" class="py-2 pr-4 font-normal">credential / issued by</th>
                    <th scope="col" class="hidden w-32 py-2 pr-4 font-normal md:table-cell">domain</th>
                    <th scope="col" class="hidden w-28 py-2 pr-4 font-normal sm:table-cell">date</th>
                    <th scope="col" class="w-16 py-2 text-right font-normal">proof</th>
                  </tr>
                </thead>
                {
                  group.entries.map((entry) => (
                    <>
                      <CertificateRow cert={entry.cert} copy={entry.copy} />
                      {entry.children.length > 0 && (
                        <>
                          {/* The dropdown that lists the certificates this one includes. */}
                          <tbody data-program-toggle={entry.cert.id}>
                            <tr class="border-b border-rule">
                              <td class="hidden md:table-cell" />
                              <td colspan="4" class="py-2 pr-4">
                                <button
                                  type="button"
                                  data-program-button
                                  aria-expanded="false"
                                  class="flex items-center gap-3 font-mono text-xs text-muted hover:text-ink"
                                >
                                  <span data-program-icon class="w-3" aria-hidden="true">+</span>
                                  {entry.children.length} courses completed for this certificate
                                </button>
                              </td>
                            </tr>
                          </tbody>
                          {entry.children.map((child) => (
                            <CertificateRow cert={child} parent={entry.cert.id} />
                          ))}
                        </>
                      )}
                    </>
                  ))
                }
              </table>
            </div>
          </section>
        ))
      }
      <p id="empty" hidden class="py-12 font-mono text-sm text-muted">No records found.</p>
    </section>
  </main>

  <footer class="mx-auto max-w-7xl border-t border-rule px-4 py-6 font-mono text-xs text-muted sm:px-6">
    updated {updated} · built with astro
  </footer>
</Layout>

<script>
  import { initGallery } from '../scripts/gallery';
  initGallery();
</script>
