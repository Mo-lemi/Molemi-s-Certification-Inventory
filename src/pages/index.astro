---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import CertificateRow from '../components/CertificateRow.astro';
import profile from '../data/profile.json';
import { certificates, providerOf, slugify, types, type Certificate } from '../lib/certificates';

const newestFirst = (a: Certificate, b: Certificate) => b.dateEarned.localeCompare(a.dateEarned);

interface Tab {
  id: string;
  label: string;
  /** Shorter name for the tab itself, so the tab row fits on one line; label is used elsewhere. */
  tabLabel?: string;
  note: string;
  count: number;
  /** The certificates this tab shows, newest first. */
  certs: Certificate[];
  /** Certificate type this tab shows; null shows everything. */
  type: string | null;
  /** For course tabs: the provider (see providerOf) this tab shows. */
  provider: string | null;
}

// Courses are split into one tab per provider, biggest first.
const courses = certificates.filter((c) => c.type === 'course');
const providers = [...new Set(courses.map((c) => providerOf(c.issuer)))]
  .map((provider) => ({ provider, certs: courses.filter((c) => providerOf(c.issuer) === provider) }))
  .sort((a, b) => b.certs.length - a.certs.length || a.provider.localeCompare(b.provider));

const listNames = (names: string[]) =>
  names.length > 1 ? `${names.slice(0, -1).join(', ')} and ${names.at(-1)}` : names[0];

// "All" opens first, then the other types (in types.json order), then the course providers.
const tabs: Tab[] = [
  {
    id: 'all',
    label: 'All',
    note: 'Every credential, course and competition on record. Open a group to see its certificates.',
    count: certificates.length,
    certs: [...certificates].sort(newestFirst),
    type: null,
    provider: null,
  },
  ...types
    .filter((type) => type.id !== 'course')
    .map((type) => {
      const certs = certificates.filter((c) => c.type === type.id).sort(newestFirst);
      return { ...type, count: certs.length, certs, type: type.id, provider: null };
    })
    .filter((tab) => tab.count > 0),
  ...providers.map(({ provider, certs }) => ({
    id: slugify(provider),
    label: provider,
    note: `Courses and programmes completed through ${listNames([...new Set(certs.map((c) => c.issuer))])}.`,
    count: certs.length,
    certs: [...certs].sort(newestFirst),
    type: 'course',
    provider,
  })),
];
const firstProviderTab = tabs.find((tab) => tab.provider);

// Every tab except "All" is one group; "All" stacks the groups in tab order.
const groups = tabs.slice(1);

const updated = new Date().toISOString().slice(0, 10);
---

<Layout title={`${profile.name} | Certificates`} description={`${profile.name}: ${profile.tagline}. ${profile.bio}`}>
  <Header />

  <main class="mx-auto max-w-7xl px-4 py-8 sm:px-6">
    <div class="mb-10 flex flex-wrap items-center gap-3">
      <label class="min-w-0 flex-1 basis-60">
        <span class="sr-only">Search records</span>
        <input id="search" type="search" placeholder="search title, issuer, skill…" class="field w-full" />
      </label>
      <label class="flex items-center gap-2 font-mono text-xs text-muted">
        sort
        <select id="sort" class="field">
          <option value="newest">newest</option>
          <option value="oldest">oldest</option>
          <option value="title">a–z</option>
        </select>
      </label>
      <p id="result-count" class="ml-auto font-mono text-xs text-muted" aria-live="polite">
        {certificates.length} records
      </p>
    </div>

    <div role="tablist" aria-label="Filter by how each certificate was earned" class="tabs -mx-4 flex border-b border-ink px-4 sm:mx-0 sm:px-0">
      {
        tabs.map((tab, i) => (
          <button
            type="button"
            role="tab"
            id={`tab-${tab.id}`}
            data-tab={tab.id}
            data-tab-type={tab.type}
            data-tab-provider={tab.provider}
            data-note={tab.note}
            aria-selected={i === 0 ? 'true' : 'false'}
            aria-controls="records"
            tabindex={i === 0 ? 0 : -1}
            class:list={['tab', tab === firstProviderTab && 'tab-group-start']}
          >
            {tab.tabLabel ?? tab.label} <span data-tab-count class="font-mono text-xs text-muted">{tab.count}</span>
          </button>
        ))
      }
    </div>

    <section id="records" role="tabpanel" aria-labelledby="tab-all" class="mb-14">
      <p id="tab-note" class="mt-3 mb-2 text-sm text-muted">{tabs[0].note}</p>
      {
        groups.map((group) => (
          <section data-group={group.id} aria-labelledby={`heading-${group.id}`}>
            {/* In the All tab each group is a dropdown: this bar opens and closes its list. Other tabs hide the bar. */}
            <h2 data-group-heading id={`heading-${group.id}`} class="font-display text-lg font-medium sm:text-xl">
              <button
                type="button"
                data-group-toggle
                aria-expanded="false"
                aria-controls={`group-${group.id}`}
                class="group flex w-full items-baseline gap-3 border-b border-rule py-4 text-left hover:border-ink"
              >
                <span data-group-icon class="w-3 shrink-0 font-mono text-sm text-muted" aria-hidden="true">+</span>
                <span class="underline-offset-4 group-hover:underline">{group.label}</span>
                <span data-group-count class="ml-auto font-mono text-xs font-normal text-muted">
                  {group.count}
                </span>
              </button>
            </h2>
            <div id={`group-${group.id}`} data-group-body class="pb-6">
              <p data-group-note class="mt-3 mb-1 text-sm text-muted">{group.note}</p>
            <table class="w-full border-collapse text-left text-sm">
              <thead class="font-mono text-xs text-muted max-sm:sr-only">
                <tr class="border-b border-rule">
                  <th scope="col" class="hidden w-24 py-2 pr-4 font-normal md:table-cell">no.</th>
                  <th scope="col" class="py-2 pr-4 font-normal">credential / issued by</th>
                  <th scope="col" class="hidden w-32 py-2 pr-4 font-normal md:table-cell">domain</th>
                  <th scope="col" class="hidden w-28 py-2 pr-4 font-normal sm:table-cell">date</th>
                  <th scope="col" class="w-16 py-2 text-right font-normal">proof</th>
                </tr>
              </thead>
              {group.certs.map((cert) => <CertificateRow cert={cert} />)}
            </table>
            </div>
          </section>
        ))
      }
      <p id="empty" hidden class="py-12 font-mono text-sm text-muted">No records found.</p>
    </section>
  </main>

  <footer class="mx-auto max-w-7xl border-t border-rule px-4 py-6 font-mono text-xs text-muted sm:px-6">
    updated {updated} · built with astro
  </footer>
</Layout>

<script>
  import { initGallery } from '../scripts/gallery';
  initGallery();
</script>
