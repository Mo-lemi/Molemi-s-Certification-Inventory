---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import CertificateRow from '../components/CertificateRow.astro';
import profile from '../data/profile.json';
import { certificates, types, type Certificate } from '../lib/certificates';

const newestFirst = (a: Certificate, b: Certificate) => b.dateEarned.localeCompare(a.dateEarned);

// One section per type (in types.json order): assessed credentials first, short courses last.
const sections = types
  .map((type) => ({ ...type, certs: certificates.filter((c) => c.type === type.id).sort(newestFirst) }))
  .filter((section) => section.certs.length > 0);

const updated = new Date().toISOString().slice(0, 10);
---

<Layout title={`${profile.name} | Certificates`} description={`${profile.name}: ${profile.tagline}. ${profile.bio}`}>
  <Header />

  <main class="mx-auto max-w-5xl px-4 py-8 sm:px-6">
    <div class="mb-10 flex flex-wrap items-center gap-3">
      <label class="min-w-0 flex-1 basis-60">
        <span class="sr-only">Search records</span>
        <input id="search" type="search" placeholder="search title, issuer, skill…" class="field w-full" />
      </label>
      <label class="flex items-center gap-2 font-mono text-xs text-muted">
        sort
        <select id="sort" class="field">
          <option value="newest">newest</option>
          <option value="oldest">oldest</option>
          <option value="title">a–z</option>
        </select>
      </label>
      <p id="result-count" class="ml-auto font-mono text-xs text-muted" aria-live="polite">
        {certificates.length} records
      </p>
    </div>

    {
      sections.map((section) => (
        <section data-section aria-labelledby={`heading-${section.id}`} class="mb-14">
          <div class="flex items-baseline justify-between gap-4 border-b border-ink pb-2">
            <h2 id={`heading-${section.id}`} class="font-display text-xl font-medium sm:text-2xl">
              {section.label}
            </h2>
            <span class="font-mono text-xs text-muted" data-section-count>
              {section.certs.length}
            </span>
          </div>
          <p class="mt-2 mb-2 text-sm text-muted">{section.note}</p>
          <table class="w-full border-collapse text-left text-sm">
            <thead class="font-mono text-xs text-muted max-sm:sr-only">
              <tr class="border-b border-rule">
                <th scope="col" class="hidden w-24 py-2 pr-4 font-normal md:table-cell">no.</th>
                <th scope="col" class="py-2 pr-4 font-normal">credential / issued by</th>
                <th scope="col" class="hidden w-32 py-2 pr-4 font-normal md:table-cell">domain</th>
                <th scope="col" class="hidden w-28 py-2 pr-4 font-normal sm:table-cell">date</th>
                <th scope="col" class="w-16 py-2 text-right font-normal">proof</th>
              </tr>
            </thead>
            {section.certs.map((cert) => <CertificateRow cert={cert} />)}
          </table>
        </section>
      ))
    }

    <p id="empty" hidden class="py-12 font-mono text-sm text-muted">No records found.</p>
  </main>

  <footer class="mx-auto max-w-5xl border-t border-rule px-4 py-6 font-mono text-xs text-muted sm:px-6">
    updated {updated} · built with astro
  </footer>
</Layout>

<script>
  import { initGallery } from '../scripts/gallery';
  initGallery();
</script>
